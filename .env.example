# ── Copy this to .env and fill in your values ──
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Run twice — use each output for JWT_SECRET and REFRESH_TOKEN_SECRET

# ── Database ──
DB_NAME=gamevault
DB_USER=gamevault
DB_PASSWORD=change_me_to_a_strong_password

# ── Auth — MUST be long random strings, keep private ──
JWT_SECRET=replace_with_64_char_random_hex_string
REFRESH_TOKEN_SECRET=replace_with_another_64_char_random_hex_string
JWT_EXPIRES_IN=15m

# ── App ──
PORT=3000
# Set this to your public URL if using Cloudflare Tunnel, e.g:
# CLIENT_URL=https://gamevault.yourdomain.com
CLIENT_URL=http://localhost:3000

# ── RAWG.io game search — free key from https://rawg.io/apidocs ──
RAWG_API_KEY=your_rawg_api_key_here

# ── Email OTP (optional — only needed if you want email 2FA) ──
# Gmail: enable 2FA on your Google account, then create an App Password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=GameVault <your_email@gmail.com>

# ── 2FA app name shown in authenticator apps ──
TOTP_APP_NAME=GameVault
